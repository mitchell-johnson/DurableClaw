{
  "name": "durable-claw-connectors-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "CONNECTOR_VAULT", "class_name": "ConnectorVault" }],
  },
  "services": [
    {
      "binding": "PRIVATE_CONNECTORS",
      "service": "durable-claw-connectors-test",
      "entrypoint": "ConnectorEntrypoint",
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConnectorVault"] }],
}
