{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "durable-claw-connectors",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_REDIRECT_URI": "",
    "GOOGLE_WORKSPACE_DOMAIN": "",
  },
  "secrets": {
    "required": [
      "CONNECTOR_AUTH_SECRET",
      "CONNECTOR_CREDENTIALS_SECRET",
      "GOOGLE_CLIENT_SECRET",
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "CONNECTOR_VAULT", "class_name": "ConnectorVault" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConnectorVault"] }],
}
