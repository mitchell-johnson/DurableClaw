{
  "name": "durable-claw",
  "version": "0.2.0",
  "private": true,
  "description": "Durable, recoverable AI agents on Cloudflare Workers",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build && wrangler deploy --dry-run",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit",
    "check:connectors": "tsc --noEmit -p services/connectors/tsconfig.json",
    "check:vendor": "node services/connectors/verify-vendor.mjs",
    "build:connectors": "wrangler deploy --dry-run --config services/connectors/wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:device": "node --test tests/device-daemon/*.test.mjs",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:identity": "vitest run --config vitest.identity.config.ts",
    "test:connectors": "vitest run --config services/connectors/vitest.config.ts",
    "types": "wrangler types worker-configuration.d.ts",
    "tail": "wrangler tail",
    "format": "prettier --write src scripts device-daemon services/connectors/src services/connectors/vendor services/connectors/tests services/connectors/vitest.config.ts services/connectors/*.json services/connectors/*.jsonc services/connectors/*.md services/connectors/*.mjs tests docs README.md ARCHITECTURE.md plan.md *.json *.ts .github/workflows",
    "format:check": "prettier --check src scripts device-daemon services/connectors/src services/connectors/vendor services/connectors/tests services/connectors/vitest.config.ts services/connectors/*.json services/connectors/*.jsonc services/connectors/*.md services/connectors/*.mjs tests docs README.md ARCHITECTURE.md plan.md *.json *.ts .github/workflows",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test:smoke": "node --test scripts/smoke-deployment.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@better-auth/passkey": "1.7.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "ai": "^6.0.197",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "marked": "18.0.12",
    "re2js": "2.8.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
