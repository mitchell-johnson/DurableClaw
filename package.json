{
  "name": "durable-claw",
  "version": "0.2.0",
  "private": true,
  "description": "Durable, recoverable AI agents on Cloudflare Workers",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build && wrangler deploy --dry-run",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "types": "wrangler types worker-configuration.d.ts",
    "tail": "wrangler tail",
    "format": "prettier --write src tests docs README.md ARCHITECTURE.md plan.md *.json *.ts .github/workflows",
    "format:check": "prettier --check src tests docs README.md ARCHITECTURE.md plan.md *.json *.ts .github/workflows"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@cloudflare/puppeteer": "1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "ai": "^6.0.197",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
